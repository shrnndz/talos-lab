# Copy this file to .secrets/rook-external.env and fill in the values emitted by
# Rook's create-external-cluster-resources.py script.
#
# The required Rook output is typically generated with a command like:
# python3 create-external-cluster-resources.py \
#   --format bash \
#   --namespace rook-ceph \
#   --skip-monitoring-endpoint \
#   --restricted-auth-permission true \
#   --k8s-cluster-name hernanfam \
#   --rbd-data-pool-name k8s_rbd \
#   --alias-rbd-data-pool-name k8s-rbd \
#   --cephfs-filesystem-name k8sfs \
#   --cephfs-data-pool-name k8sfs_data
#
# Use dedicated Ceph pools/filesystems for Kubernetes when possible. If Ceph mgr
# Prometheus metrics are enabled later, you can remove --skip-monitoring-endpoint
# and regenerate the file.

NAMESPACE=rook-ceph

# Keep the original generator arguments here so we can store them in a ConfigMap.
ARGS=

ROOK_EXTERNAL_FSID=
ROOK_EXTERNAL_USERNAME=
ROOK_EXTERNAL_USER_SECRET=
ROOK_EXTERNAL_CEPH_MON_DATA=

CSI_RBD_NODE_SECRET=
CSI_RBD_NODE_SECRET_NAME=
CSI_RBD_PROVISIONER_SECRET=
CSI_RBD_PROVISIONER_SECRET_NAME=
RBD_POOL_NAME=
RBD_STORAGE_CLASS_NAME=ceph-rbd

# Optional if your RBD data pool is erasure coded.
RBD_METADATA_EC_POOL_NAME=

# Optional CephFS support. Leave blank if you only want RBD.
CSI_CEPHFS_NODE_SECRET=
CSI_CEPHFS_NODE_SECRET_NAME=
CSI_CEPHFS_PROVISIONER_SECRET=
CSI_CEPHFS_PROVISIONER_SECRET_NAME=
CEPHFS_FS_NAME=
CEPHFS_POOL_NAME=
CEPHFS_STORAGE_CLASS_NAME=cephfs

# Optional overrides. The defaults are safe for most 3-mon external clusters.
ROOK_EXTERNAL_CLUSTER_NAME=rook-ceph
ROOK_EXTERNAL_ADMIN_SECRET=admin-secret
ROOK_EXTERNAL_MONITOR_SECRET=mon-secret
ROOK_EXTERNAL_MAPPING={}
ROOK_EXTERNAL_MAX_MON_ID=2
ROOK_RBD_FEATURES=layering
CSI_DRIVER_NAME_PREFIX=rook-ceph
